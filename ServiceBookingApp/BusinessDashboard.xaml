<Page x:Class="ServiceBookingApp.BusinessDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ServiceBookingApp"
        mc:Ignorable="d"
        Title="BusinessDashboard" MinHeight="550" MinWidth="800" MaxHeight="600" MaxWidth="1000"
        Loaded="LoadBusiness">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="20*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <Rectangle Fill="Purple" Grid.Row="0" Grid.ColumnSpan="3"/>

        <TextBlock Text="Dashboard" 
           FontSize="20" 
           FontWeight="Bold" 
           Foreground="AliceBlue"
           HorizontalAlignment="Center" 
           VerticalAlignment="Center" 
           Grid.ColumnSpan="3" 
           Grid.Row="0"
           Grid.Column="1"/>
        <TextBlock x:Name="businessName"
           Text="" 
           FontSize="16" 
           FontWeight="Bold" 
           Foreground="AliceBlue"
           HorizontalAlignment="Center" 
           VerticalAlignment="Center" 
           Grid.ColumnSpan="1" 
           Grid.Row="0"
           Grid.Column="0"/>        
        <Button Content="Dashboard" 
                FontSize="16" 
                Grid.Column="0"
                Grid.Row="1"/>
        <Button Content="Bookings"
                FontSize="16" 
                Grid.Column="0"
                Grid.Row="2"/>
        <Button Content="Services"
                FontSize="16" 
                Grid.Column="0"
                Grid.Row="3"/>
        <Button Content="Logout" 
                FontSize="16" 
                Grid.Column="0"
                Grid.Row="4" 
                Click="LogoutButton_Click"/>
        <Frame x:Name="DashboardFrame"  NavigationUIVisibility="Hidden" Grid.ColumnSpan="2"  Grid.Column="1" Grid.Row="1" Grid.RowSpan="5"/>

    </Grid>
</Page>
