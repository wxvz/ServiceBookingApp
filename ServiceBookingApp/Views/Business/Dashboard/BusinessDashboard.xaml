<Page
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ServiceBookingApp"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf" 
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" x:Class="ServiceBookingApp.BusinessDashboard"
        mc:Ignorable="d"
        Title="BusinessDashboard" MinHeight="720" MinWidth="1080"
        Loaded="LoadBusiness">


    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="20*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Rectangle Fill="Teal" Grid.Row="0" Grid.ColumnSpan="3"/>

        <TextBlock Text="Dashboard" 
           FontSize="20" 
           FontWeight="Bold" 
           Foreground="AliceBlue"
           HorizontalAlignment="Center" 
           VerticalAlignment="Center" 
           Grid.ColumnSpan="3" 
           Grid.Row="0"
           Grid.Column="1"/>

        <TextBlock x:Name="businessName"
           Text="" 
           FontSize="16" 
           FontWeight="Bold" 
           Foreground="AliceBlue"
           HorizontalAlignment="Center" 
           VerticalAlignment="Center" 
           Grid.ColumnSpan="1" 
           Grid.Row="0"
           Grid.Column="0"/>

       
        <TextBlock x:Name="DashboardHeaderTBX"
                Text="Manage your bookings and services."    
                FontSize="18" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                Grid.ColumnSpan="2" 
                Grid.Column="1" Grid.Row="1"/>

        <TextBlock x:Name="totalBookingsTBX"
                   Text="" 
                   FontSize="18" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   Grid.Column="1" Grid.Row="2"/>

        <TextBlock x:Name="totalRevenueTBX"
                    Text="" 
                    FontSize="18" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Grid.Column="2" Grid.Row="2"/>

        <!-- Statistics chart -->
        <lvc:PieChart x:Name="PieChartStats" 
              Series="{Binding ServiceBookingsChart}" 
              InnerRadius="50" 
              Grid.Column="1" Grid.Row="4" Grid.RowSpan="2"
              LegendLocation="Bottom"  
              Margin="10"/>
        
        <!-- bar cHART FOR rEVENUE-->
        <lvc:CartesianChart x:Name="BarChartStats"
              Series="{Binding MonthlyRevenueChart}" 
              Grid.Column="2" Grid.Row="4" Grid.RowSpan="2"
              LegendLocation="None"  
              Margin="10"
              >
            <lvc:CartesianChart.AxisX>
                <lvc:Axis Margin="0,0,0,10" Labels="{Binding MonthLabels}"/>
            </lvc:CartesianChart.AxisX>
            
            <lvc:CartesianChart.AxisY>
                <lvc:Axis Title="Monthly Revenue" LabelFormatter="{Binding CurrencyFormatter}" MinValue="0"/>
            </lvc:CartesianChart.AxisY>
        </lvc:CartesianChart>

        <!-- Navigation -->
        
        <Rectangle Fill="LightGray" Grid.RowSpan="6" Grid.Column="0" Grid.ColumnSpan="1" Grid.Row="1" />

        <StackPanel Grid.Column="0" Grid.Row="1"  Grid.RowSpan="5">
            

            <StackPanel>
                <Button Content="Dashboard" 
                        Style="{StaticResource MaterialDesignFlatButton}"
                        FontSize="16" 
                        HorizontalContentAlignment="Left"
                        Margin="10,10,10,0"
                        Click="DashboardButton_Click"/>
            </StackPanel>

            <StackPanel>
                <Expander Header="Profile" FontSize="16" Margin="10,10,10,0" VerticalAlignment="Center" 
                    Background="Transparent" Foreground="Teal" HorizontalAlignment="Left">
                    <StackPanel Margin="10,0,0,0">
                        <Button Content="Edit Profile" Style="{StaticResource MaterialDesignFlatButton}" Click="EditProfile_Click"/>
                    </StackPanel>
                </Expander>
            </StackPanel>

            <StackPanel>
                <Expander Grid.Row="2" Grid.Column="0" Header="Bookings" FontSize="16" Margin="10,0" VerticalAlignment="Center" 
                          Background="Transparent" Foreground="Teal" HorizontalAlignment="Left">
                    <StackPanel Margin="10,0,0,0">
                        <Button Content="View Bookings" Style="{StaticResource MaterialDesignFlatButton}" Click="ViewBookings_Click"/>
                        <Button Content="Manage Bookings" Style="{StaticResource MaterialDesignFlatButton}" Click="ManageBookings_Click"/>
                        <Button Content="Notifications" Style="{StaticResource MaterialDesignFlatButton}" Click="Notifications_Click"/>
                    </StackPanel>
                </Expander>
            </StackPanel>


            <StackPanel>
                <Expander Grid.Row="3" Grid.Column="0" Header="Services" FontSize="16" Margin="10,0" VerticalAlignment="Center" 
                          Background="Transparent" Foreground="Teal" HorizontalAlignment="Left">
                    <StackPanel Margin="10,0,0,0">
                        <Button Content="Manage Services" Style="{StaticResource MaterialDesignFlatButton}" Click="ManageServices_Click" />
                        <Button Content="Manage Schedules" Style="{StaticResource MaterialDesignFlatButton}" Click="ManageSchedules_Click" />
                    </StackPanel>
                </Expander>
            </StackPanel>
            
            

            <Button Content="Logout" 
                Style="{StaticResource MaterialDesignFlatButton}"
                FontSize="16" 
                Grid.Column="0"
                Grid.Row="5" 
                Click="LogoutButton_Click"
                HorizontalContentAlignment="Left"
                VerticalAlignment="Top"
                Margin="10,10,10,0"/>
        </StackPanel>
        
        <Frame x:Name="DashboardFrame"  NavigationUIVisibility="Hidden" Grid.ColumnSpan="2"  Grid.Column="1" Grid.Row="1" Grid.RowSpan="5"/>

    </Grid>
</Page>
