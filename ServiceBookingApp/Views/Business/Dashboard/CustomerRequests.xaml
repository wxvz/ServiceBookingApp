<Page x:Class="ServiceBookingApp.Views.Business.Dashboard.CustomerRequests"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ServiceBookingApp.Views.Business.Dashboard"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Background="White"
      Title="CustomerRequests"
      Loaded="Page_Loaded">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Customer Requests" FontSize="24" FontWeight="Bold" Margin="20,20,0,20"/>
        
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Margin="20,0,20,10" Padding="15" Background="#F1FFFA">
            <StackPanel>
                <TextBlock Text="Filter by Request Type" 
                   FontSize="14" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,5"/>
                <ComboBox x:Name="RequestTypeFilterCBX"
                  SelectionChanged="RequestTypeFilterCBX_SelectionChanged"
                  MinWidth="200"
                  />
            </StackPanel>
        </Border>

        <DataGrid x:Name="RequestsDataGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" Margin="20" Background="White" RowBackground="#F9F9F9" AlternatingRowBackground="#FFFFFF" BorderBrush="Gray" BorderThickness="1" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                <DataGridTextColumn Header="Booking Date" Binding="{Binding BookingDateTime, StringFormat=\{0:dd MMM yyyy HH:mm\}}" Width="*"/>
                <DataGridTextColumn Header="Request Type" Binding="{Binding Request}" Width="*"/>
                <DataGridTemplateColumn Header="Actions" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Resolve/Dismiss" Click="ActionRequest_Click" Margin="2" Padding="5,2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border x:Name="ActionPanel" Grid.Row="2" Visibility="Collapsed" Background="White" Margin="20" Padding="20" BorderBrush="Gray" BorderThickness="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Action Request" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                
                <TextBlock x:Name="RequestDetailsTextBlock" Text="Details will appear here" TextWrapping="Wrap" Margin="0,0,0,20" MaxWidth="400"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Content="Approve" Click="ApproveRequest_Click" Background="#78A1BB" BorderBrush="#28536B" Foreground="White" Width="100" Margin="0,0,10,0"/>
                    <Button Content="Dismiss" Click="DismissRequest_Click" Background="#CA6875" BorderBrush="#4A1C20" Foreground="White" Width="100" Margin="0,0,10,0"/>
                    <Button Content="Back" Background="#F0F0F0" BorderBrush="Gray" Click="CancelAction_Click" Width="80"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
