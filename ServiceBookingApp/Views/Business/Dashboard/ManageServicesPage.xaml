<Page x:Class="ServiceBookingApp.ManageServicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ServiceBookingApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ManageServicesPage" Loaded="Page_Loaded">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Manage Services" FontSize="24" FontWeight="Bold" Margin="10"/>

        <Grid Grid.Row="1">
            <!-- Add Service Form -->
            <Border x:Name="CreateServicePanel" BorderBrush="Gray" BorderThickness="1" Margin="10" Padding="10" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Add New Service" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Name:" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="NameBox" Grid.Column="1" Margin="5"/>

                        <TextBlock Text="Price (Euro):" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="PriceBox" Grid.Column="3" Margin="5"/>

                        <TextBlock Text="Duration (min):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="DurationBox" Grid.Row="1" Grid.Column="1" Margin="5"/>

                        <TextBlock Text="Description:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="DescriptionBox" Grid.Row="1" Grid.Column="3" Margin="5"/>
                    </Grid>
                    <Button Content="Add Service" HorizontalAlignment="Center" Width="110" Margin="0,10,0,5" Click="AddService_Click"/>
                </StackPanel>
            </Border>

            <!-- Update Service Form -->
            <Border x:Name="UpdateServicePanel" BorderBrush="Gray" BorderThickness="1" Margin="10" 
                    Padding="10" CornerRadius="5" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Update Service" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Name:" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="UpdateNameBox" Grid.Column="1" Margin="5"/>

                        <TextBlock Text="Price:" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="UpdatePriceBox" Grid.Column="3" Margin="5"/>

                        <TextBlock Text="Duration (min):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="UpdateDurationBox" Grid.Row="1" Grid.Column="1" Margin="5"/>

                        <TextBlock Text="Description:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="UpdateDescriptionBox" Grid.Row="1" Grid.Column="3" Margin="5"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,5">
                        <Button Content="Update" Width="110" Margin="5" Click="UpdateService_Click"/>
                        <Button Content="Cancel" Width="110" Margin="5" Click="CancelUpdateService_Click" Background="Gray" BorderBrush="Gray"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Services List -->
        <DataGrid x:Name="ServicesDataGrid" Grid.Row="2" Margin="10" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" BorderBrush="Gray" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Price (Euro)" Binding="{Binding Price, StringFormat=F2}" Width="110"/>
                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="120"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                <DataGridTemplateColumn Header="Actions" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Edit" Click="EditService_Click" Margin="2" Tag="{Binding}"/>
                                <Button Content="Delete" Click="DeleteService_Click" Margin="2" Tag="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
