<Page x:Class="ServiceBookingApp.Views.Customer.Booking_Flow.BookServicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ServiceBookingApp.Views.Customer.Booking_Flow"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="BookServicePage"
      Background="White"
      Loaded="Page_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Select a Business to Book With" FontSize="24" FontWeight="Bold" Margin="0,0,0,10" Foreground="#139174"/>
        
        <TextBlock x:Name="NoBusinessesText" Grid.Row="1" Text="No businesses available." Foreground="Gray" Visibility="Collapsed" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="BusinessesItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#139174" BorderThickness="1" CornerRadius="5" Margin="10" Padding="15" Background="#F1FFFA" Width="300">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding Address}" FontStyle="Italic" Foreground="Gray" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding PhoneNumber}" Foreground="Gray" Margin="0,0,0,15"/>
                                <Button Content="View Services" Tag="{Binding BusinessId}" Click="ViewServices_Click" Background="#139174" Foreground="White" Padding="5"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
