<Page x:Class="ServiceBookingApp.Views.Customer.Booking_Flow.BusinessBookingProfile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ServiceBookingApp.Views.Customer.Booking_Flow"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="BusinessBookingProfile"
      Background="White"
      Loaded="Page_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Content="Back to Businesses" Click="Back_Click" Background="LightGray" Foreground="Black" Width="150" HorizontalAlignment="Left" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock x:Name="BusinessNameText" FontSize="26" FontWeight="Bold" Foreground="#139174"/>
            <TextBlock x:Name="BusinessDescriptionText" FontSize="14" Foreground="Gray" TextWrapping="Wrap" Margin="0,5,0,0"/>
            <TextBlock x:Name="BusinessContactText" FontSize="12" FontStyle="Italic" Margin="0,5,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Available Services" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBlock x:Name="NoServicesText" Grid.Row="3" Text="No services available for this business." Foreground="Gray" Visibility="Collapsed"/>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ServicesItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="0,0,0,10" Padding="15" Background="#F9F9F9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,5,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Price: " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Price, StringFormat={}{0:C}}" Margin="0,0,15,0"/>
                                        <TextBlock Text="Duration: " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Duration, StringFormat={}{0:hh\\:mm}}"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="1" Content="Book" Tag="{Binding ServiceId}" Click="BookService_Click" Background="#139174" Foreground="White" Width="80" Height="35" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
