<Page x:Class="ServiceBookingApp.Views.Customer.Booking_Flow.ConfirmBookingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ServiceBookingApp.Views.Customer.Booking_Flow"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="ConfirmBookingPage"
      Background="White"
      Loaded="Page_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Content="Back" Click="Back_Click" Background="LightGray" Foreground="Black" Width="100" HorizontalAlignment="Left" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="Confirm Your Booking" FontSize="26" FontWeight="Bold" Foreground="#139174"/>
            <TextBlock x:Name="ServiceNameText" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,0"/>
            <TextBlock x:Name="ServiceDetailsText" FontSize="14" Foreground="Gray" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Select Date:" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <DatePicker x:Name="BookingDatePicker" Grid.Column="1" Width="200" HorizontalAlignment="Left" SelectedDateChanged="BookingDatePicker_SelectedDateChanged" Margin="0,0,0,10"/>

            <TextBlock Text="Available Slots:" Grid.Row="1" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <ComboBox x:Name="AvailableTimeComboBox" Grid.Row="1" Grid.Column="1" Width="200" HorizontalAlignment="Left"/>

            <TextBlock Text="Payment Method:" Grid.Row="2" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="PaymentMethodComboBox" Grid.Row="2" Grid.Column="1" Width="200" HorizontalAlignment="Left" SelectionChanged="PaymentMethodComboBox_SelectionChanged"/>

        </Grid>
        
        <StackPanel x:Name="CardDetailsPanel" Grid.Row="3" Margin="0,0,0,20" Visibility="Collapsed">
            <TextBlock Text="Card Number:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="CardNumberTextBox" Width="200" HorizontalAlignment="Left" Margin="0,0,0,10" MaxLength="16"/>

            <TextBlock Text="Expiry Date (MM/YY):" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="ExpiryDateTextBox" Width="100" HorizontalAlignment="Left" Margin="0,0,0,10" MaxLength="5"/>

            <TextBlock Text="CVV:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="CvvTextBox" Width="50" HorizontalAlignment="Left" Margin="0,0,0,10" MaxLength="3"/>
        </StackPanel>
        
        <TextBlock x:Name="NoSlotsText" Grid.Row="3" Text="No available slots for the selected date." Foreground="Red" Visibility="Collapsed" Margin="0,0,0,20"/>

        <Button x:Name="ConfirmButton" Grid.Row="4" Content="Confirm Booking" Click="ConfirmBooking_Click" Background="#139174" Foreground="White" Width="200" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top"/>
    </Grid>
</Page>


