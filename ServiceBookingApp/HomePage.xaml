<Page x:Class="ServiceBookingApp.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ServiceBookingApp"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      Title="HomePage"
      Background="White"
      Loaded="SessionCheck">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="24*"/>
            <RowDefinition Height="83*"/>
            <RowDefinition Height="110*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Service Booking Application" 
           FontSize="20" 
           FontWeight="Bold" 
           HorizontalAlignment="Center" 
           VerticalAlignment="Center" 
           Grid.ColumnSpan="4" 
           Grid.Row="0"/>

        <TextBlock Text="Log in as a" 
           FontSize="18"  
           HorizontalAlignment="Center" 
           VerticalAlignment="Top" 
           Grid.ColumnSpan="2" 
           Grid.Row="1" Grid.Column="1" Margin="0,25,0,0"/>

        <Button x:Name="customerBtn"
                Content="Customer"
                FontSize="20"
                Grid.Row="1"
                Grid.ColumnSpan="4"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" Click="customerBtn_Click"/>

        <TextBlock Text="Or" 
            FontSize="18"  
            HorizontalAlignment="Center" 
            VerticalAlignment="Bottom" 
            Grid.ColumnSpan="2" 
            Grid.Row="1" Grid.Column="1" Margin="0,0,0,25"/>

        <Button x:Name="businessBtn"
            Content="Business"
            FontSize="20"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center" 
            VerticalAlignment="Top" Grid.Column="1" Margin="0,10,0,0" Click="businessBtn_Click"/>

    </Grid>
</Page>
