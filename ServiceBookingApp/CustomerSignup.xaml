<Page x:Class="ServiceBookingApp.CustomerSignup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ServiceBookingApp"
        mc:Ignorable="d"
        Title="CustomerSignup" 
       MinHeight="596" MinWidth="890" MaxHeight="650" MaxWidth="1000"
       Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="9*"/>
        </Grid.RowDefinitions>
        
        <Button Content="Back" 
                FontSize="14" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Top" 
                Margin="10,15,0,10" 
                Padding="3"
                Click="BackButton_Click"/>
        
        <TextBlock Text="Sign Up" 
                FontSize="20" 
                FontWeight="Bold" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                Grid.ColumnSpan="4" 
                Grid.Row="0"/>
        
        <TextBlock Text="Enter your details below"
                   FontSize="18"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Grid.ColumnSpan="4"
                   Grid.Row="1" Margin="0,25,0,0"/>
        
        <TextBlock Text="First Name:"
                   FontSize="18"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Grid.ColumnSpan="4"
                   Grid.Row="1" Margin="170,95,0,0"/>
        
        <TextBox x:Name="firstNameTBX"
                 FontSize="18"
                 Grid.Row="1"
                 Grid.ColumnSpan="4"
                 HorizontalAlignment="Center" 
                 VerticalAlignment="Top" Margin="0,95,0,0" Width="200"/>
        
        <TextBlock Text="Last Name:"
                   FontSize="18"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Grid.ColumnSpan="4"
                   Grid.Row="1" Margin="170,145,0,0"/>
        
        <TextBox x:Name="lastNameTBX"
                 FontSize="18"
                 Grid.Row="1"
                 Grid.ColumnSpan="4"
                 HorizontalAlignment="Center" 
                 VerticalAlignment="Top" Margin="0,145,0,0" Width="200"/>
        
        <TextBlock Text="Email Address:"
                   FontSize="18"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Grid.ColumnSpan="4"
                   Grid.Row="1" Margin="170,195,0,0"/>
        
        <TextBox x:Name="emailTBX"
                 FontSize="18"
                 Grid.Row="1"
                 Grid.ColumnSpan="4"
                 HorizontalAlignment="Center" 
                 VerticalAlignment="Top" Margin="0,195,0,0" Width="200"/>

        <TextBlock Text="Phone Number:"
                   FontSize="18"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Grid.ColumnSpan="4"
                   Grid.Row="1" Margin="170,245,0,0"/>

        <TextBox x:Name="phoneTBX"
                 FontSize="18"
                 Grid.Row="1"
                 Grid.ColumnSpan="4"
                 HorizontalAlignment="Center" 
                 VerticalAlignment="Top" Margin="0,245,0,0" Width="200"/>

        <TextBlock Text="Password:"
                   FontSize="18"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Grid.ColumnSpan="4"
                   Grid.Row="1" Margin="170,295,0,0"/>

        <PasswordBox x:Name="passwordPBX"
                     FontSize="18"
                     Grid.Row="1"
                     Grid.ColumnSpan="4"
                     HorizontalAlignment="Center" 
                     VerticalAlignment="Top" Margin="0,295,0,0" Width="200"/>

        <TextBlock Text="Confirm Password:"
                   FontSize="18"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Grid.ColumnSpan="4"
                   Grid.Row="1" Margin="170,345,0,0"/>

        <PasswordBox x:Name="confirmPasswordPBX"
                     FontSize="18"
                     Grid.Row="1"
                     Grid.ColumnSpan="4"
                     HorizontalAlignment="Center" 
                     VerticalAlignment="Top" Margin="0,345,0,0" Width="200"/>

        <Button Content="Sign Up"
                FontSize="18"
                Grid.Row="1"
                Grid.ColumnSpan="4"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" Margin="0,0,0,-350" Width="100" Click="SignUpBtn_Click"/>
        
    </Grid>
</Page>
