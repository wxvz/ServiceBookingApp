<Page x:Class="ServiceBookingApp.BusinessLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ServiceBookingApp"
        mc:Ignorable="d"
        Title="BusinessLogin" MinHeight="550" MinWidth="800" MaxHeight="600" MaxWidth="1000"
        Background="White">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="9*"/>
        </Grid.RowDefinitions>
        
        <Button Content="Back" 
                FontSize="14" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Top" 
                Margin="10,15,0,10" 
                Padding="3"
                Click="BackButton_Click"/>
        
        <TextBlock Text="Business Log in" 
                FontSize="20" 
                FontWeight="Bold" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                Grid.ColumnSpan="4" 
                Grid.Row="0"/>
        
        <TextBlock Text="Enter your email address and password"
                FontSize="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Grid.ColumnSpan="4"
                Grid.Row="1" Margin="0,25,0,0"/>
        
        <TextBlock Text="Email Address:"
                FontSize="18"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Grid.ColumnSpan="4"
                Grid.Row="1" Margin="170,95,0,0"/>
        
        <TextBox x:Name="emailTextBox"
                 
                 FontSize="18"
                 Grid.Row="1"
                 Grid.ColumnSpan="4"
                 HorizontalAlignment="Center" 
                 VerticalAlignment="Top" Margin="0,95,0,0" Width="200"/>
        
        <TextBlock Text="Password:"
                    FontSize="18"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Grid.ColumnSpan="4"
                    Grid.Row="1" Margin="170,165,0,0"/>
        
        <PasswordBox x:Name="passwordBox"
                     FontSize="18"
                     Grid.Row="1"
                     Grid.ColumnSpan="4"
                     HorizontalAlignment="Center" 
                     VerticalAlignment="Top" Margin="0,165,0,0" Width="200"/>
        
        <Button x:Name="loginBtn"
                Content="Log In"
                FontSize="18"
                Grid.Row="1"
                Grid.ColumnSpan="4"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" Margin="0,20,0,0" Width="100" Click="LoginBtn_Click"/>
        
        <BulletDecorator Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,90,0,0">
            <BulletDecorator.Bullet>
                <TextBlock Text="Don't have an account?" FontSize="14"/>
            </BulletDecorator.Bullet>
            <TextBlock Text=" Sign up here!" FontSize="14" Foreground="Blue" Cursor="Hand" MouseLeftButtonUp="SignUpBusinessLink_MouseLeftButtonUp"/>
        </BulletDecorator>

    </Grid>
</Page>
